{
  "name": "dshtavern",
  "version": "0.1.0",
  "description": "SillyTavern-style role-play for the DeepSeek Harness: a tavern is a workspace with a marker file, each chat is a session, and every beat is a director call plus one isolated call per speaking character.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./session": {
      "types": "./lib/types/session.d.ts",
      "default": "./lib/session.js"
    },
    "./stats": {
      "types": "./lib/types/stats/index.d.ts",
      "default": "./lib/stats/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./stats/locale/*.json": "./locale-stats/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "locale-stats",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.types.json && tsdown -c tsdown.config.ts",
    "bundle": "tsdown -c tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
